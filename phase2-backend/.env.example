# --- Postgres (used by docker-compose AND the API) ---
POSTGRES_USER=zimra_qpd
POSTGRES_PASSWORD=change-me-to-something-long-and-random
POSTGRES_DB=zimra_qpd

# Full async DSN the API connects with (host is "db" inside docker-compose network,
# swap to "localhost" if running the API outside Docker against a Dockerized DB)
DATABASE_URL=postgresql+asyncpg://zimra_qpd:change-me-to-something-long-and-random@db:5432/zimra_qpd

# Sync DSN, used only by Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg2://zimra_qpd:change-me-to-something-long-and-random@db:5432/zimra_qpd

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-this-with-a-generated-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- MFA ---
MFA_ISSUER_NAME=ZIMRA QPD Calculator

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
