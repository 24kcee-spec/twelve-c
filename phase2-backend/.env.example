# Postgres
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
DATABASE_URL_SYNC=postgresql://user:password@host/dbname

# JWT
JWT_SECRET_KEY=replace-with-a-long-random-string

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Frontend URL - used inside verification emails
FRONTEND_URL=http://localhost:3000

# Resend (https://resend.com) - transactional email for verification links
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=Twelve C <onboarding@resend.dev>

# Google Sign-In (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
