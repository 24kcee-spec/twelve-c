# Root-level gitignore

# Environment files and local secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Python
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/
.envrc

# Node / frontend
node_modules/
.next/
out/
dist/
build/
coverage/

# Packaging / generated artifacts
*.egg-info/
**/*.egg-info/
*.egg
*.dist-info/
*.bak
*.bak-*
*.orig
*.rej
*.log

# Diagnostic and generated outputs
diagnostics/*.txt
diagnostics/*.sql
**/test_output.txt
**/*.pyc
**/*.pyo
**/__pycache__/

# System files
.DS_Store
Thumbs.db

# Project-specific generated outputs
phase4-fiscal/**/*.pem
phase4-fiscal/**/*.key
phase4-fiscal/**/*.csr
phase4-fiscal/**/certs/
phase4-fiscal/**/*.p12
