# URL of the Phase 2 FastAPI backend (zimra_qpd_api)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Required fixed study rate (ZiG per USD). Enter the independently approved Task 5 value before building/deploying.
NEXT_PUBLIC_STUDY_EXCHANGE_RATE=

# Google OAuth Client ID, from https://console.cloud.google.com/apis/credentials
# Leave blank to hide the "Continue with Google" button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
